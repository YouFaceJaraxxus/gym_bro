# ─────────────────────────────────────────────────────────────────────────────
# .env.template — keys stored in Supabase secrets.
# Run scripts/pull_secrets.sh to populate .env with real values.
#
# To add a new secret:
#   1. supabase secrets set NEW_KEY=value
#   2. Add the key name here
#   3. Commit this file
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_URL=
SUPABASE_ANON_KEY=
SUPABASE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Payments (Stripe). Payments are disabled when STRIPE_SECRET_KEY is empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_CURRENCY=usd
PAYMENT_RETURN_URL=

# Push notifications (Firebase Cloud Messaging HTTP v1). Service account JSON,
# base64-encoded. Push is disabled when empty; in-app notifications still work.
FCM_SERVICE_ACCOUNT_B64=

# Shared secret pg_cron sends to the `jobs` function.
CRON_SECRET=

# Signs gym check-in QR codes. Falls back to a key derived from the service role key.
CHECKIN_SECRET=
